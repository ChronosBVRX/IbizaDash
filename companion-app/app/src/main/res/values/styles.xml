<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IbizaCompanion" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/panel</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/accent_sky</item>
        <item name="colorAccent">@color/accent_sky</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>

    <style name="CardPanel">
        <item name="android:background">@drawable/bg_glass_panel</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="AccentButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/accent_sky</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="GhostButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>