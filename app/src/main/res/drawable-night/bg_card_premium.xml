<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism noche -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#CC1E2736"
                android:endColor="#B3131922" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
