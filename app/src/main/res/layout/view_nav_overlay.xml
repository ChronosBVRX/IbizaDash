<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista de navegación (Fase A): se muestra sobre el mapa cuando el foco es NAV.
    La tarjeta superior resume la maniobra; el resto del mapa queda libre para
    tocarlo (arrastrar para explorar) sin bloquear gestos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Tarjeta de maniobra -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_sheet"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/navCardIconBadge"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_play_button">

                <ImageView
                    android:id="@+id/navCardIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="Maniobra"
                    android:src="@drawable/ic_mav_straight"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/navCardDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:minWidth="96dp"
                android:text="--"
                android:textColor="@color/text_primary"
                android:textSize="38sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navCardAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:text="Sin destino activo"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/navCardThen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Planifica una ruta desde IbizaCompanion"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navCardEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:text=""
                    android:textColor="@color/accent_sky"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/navCardRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/navExit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Salir de la navegación"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/navCardProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_media_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navCardDest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navCardTraffic"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#22F59E0B"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="TRÁFICO +6 MIN"
                android:textColor="@color/amber"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/navFinish"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_action_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="FINALIZAR"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Recentrar: aparece cuando el usuario mueve el mapa -->
    <FrameLayout
        android:id="@+id/btnRecenter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_play_button"
        android:contentDescription="Centrar en el vehículo"
        android:elevation="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Centrar"
            android:src="@drawable/ic_nav"
            android:tint="#FFFFFF" />
    </FrameLayout>
</FrameLayout>
