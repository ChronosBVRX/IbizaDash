<?xml version="1.0" encoding="utf-8"?>
<!--
    HUD de navegación 2.5D.
    - Tarjeta de maniobra verde petróleo con sub-píldora "Luego".
    - Botones circulares translúcidos a la derecha (brújula, mapa, voz).
    - Píldoras inferiores: resumen del viaje y "Centrar".
    El mapa queda libre para arrastrar; esta capa no bloquea gestos fuera de
    sus hijos clicables.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Tarjeta de maniobra -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_nav_card"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_nav_badge">

                <ImageView
                    android:id="@+id/navCardIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="Maniobra"
                    android:src="@drawable/ic_mav_straight"
                    android:tint="#0D5C56" />
            </FrameLayout>

            <TextView
                android:id="@+id/navCardDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:minWidth="90dp"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navCardAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:text="Sin destino activo"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navCardRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#B9D9D4"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navCardEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:text=""
                    android:textColor="#9FF3EA"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/navExit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Salir de la navegación"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:tint="#B9D9D4" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/navCardProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_media_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navCardDest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#9CC7C2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navCardTraffic"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#33F59E0B"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="TRÁFICO +6 MIN"
                android:textColor="@color/amber"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/navFinish"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_action_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="FINALIZAR"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sub-píldora "Luego [ícono]" -->
        <LinearLayout
            android:id="@+id/navCardThenRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_subpill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/navCardThenIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Siguiente maniobra"
                android:src="@drawable/ic_mav_straight"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/navCardThen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text=""
                android:textColor="#E6FFFB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones circulares del HUD -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnCompass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nav_fab"
            android:contentDescription="Brújula: norte o rumbo arriba"
            android:padding="12dp"
            android:src="@drawable/ic_compass"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnMapStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nav_fab"
            android:contentDescription="Selector de mapa"
            android:padding="12dp"
            android:src="@drawable/ic_layers"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_nav_fab"
            android:contentDescription="Silenciar voz de navegación"
            android:padding="12dp"
            android:src="@drawable/ic_volume"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Resumen del viaje -->
    <LinearLayout
        android:id="@+id/navSummaryPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_nav_summary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/navSummaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Recentrar: aparece cuando el usuario mueve el mapa -->
    <LinearLayout
        android:id="@+id/btnRecenter"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_nav_summary"
        android:clickable="true"
        android:contentDescription="Centrar en el vehículo"
        android:elevation="14dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Centrar"
            android:src="@drawable/ic_nav"
            android:tint="#00E5FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Centrar"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
