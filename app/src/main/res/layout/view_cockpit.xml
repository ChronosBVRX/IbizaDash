<?xml version="1.0" encoding="utf-8"?>
<!-- Cockpit panel: full 45% focus. Shared session state with the mini HUD and modules. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cockpitPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/screen_margin"
    android:layout_marginTop="@dimen/screen_margin"
    android:layout_marginEnd="@dimen/screen_margin"
    android:layout_marginBottom="@dimen/panel_bottom_gap"
    android:background="@drawable/bg_panel"
    android:elevation="@dimen/elev_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- Bluetooth chip + quick settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btChip"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Bluetooth"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/accent_sky" />

            <TextView
                android:id="@+id/btStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Sin conectar"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:id="@+id/btDivider"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#22FFFFFF"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btBatteryGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Batería"
                    android:src="@drawable/ic_battery"
                    android:tint="@color/green" />

                <ProgressBar
                    android:id="@+id/btBatteryBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:max="100"
                    android:progress="87"
                    android:progressDrawable="@drawable/bg_battery_progress" />

                <TextView
                    android:id="@+id/btBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFeatureSettings="tnum"
                    android:text="87%"
                    android:textColor="@color/green"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ajustes rápidos"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_muted" />
    </LinearLayout>

    <!-- HUD speed + gear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/speed"
            style="@style/Hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/speed_unit_kmh"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/gear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_gear_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="38dp"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="P"
                android:textColor="#06121F"
                android:textSize="18sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cockpitFuel"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip_glass"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="F --"
            android:textColor="@color/accent_cyan" />

        <TextView
            android:id="@+id/speedSource"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip_glass"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="GPS" />
    </LinearLayout>

    <!-- Vehicle stage: floor glow + render -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="150dp">

        <View
            android:layout_width="300dp"
            android:layout_height="110dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_floor_glow" />

        <ImageView
            android:id="@+id/carRender"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="SEAT Ibiza 2010"
            android:scaleType="fitCenter"
            android:src="@drawable/ibiza_render" />

        <View
            android:id="@+id/headlightGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_headlight_glow"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Floating luxury media card -->
    <LinearLayout
        android:id="@+id/mediaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_insight_card"
        android:elevation="@dimen/elev_card"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_media_stage"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_album"
                    android:clipToOutline="true"
                    android:contentDescription="@string/media_title"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media"
                    android:tint="@color/text_muted" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/media_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/mediaSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/media_subtitle"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Anterior"
                android:padding="12dp"
                android:src="@drawable/ic_prev"
                android:tint="@color/text_muted" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="Reproducir"
                android:elevation="6dp"
                android:padding="13dp"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Siguiente"
                android:padding="12dp"
                android:src="@drawable/ic_next"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/mediaProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_media_progress" />

        <TextView
            android:id="@+id/mediaTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_faint"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Thermal/electrical health (replaces the fake A/C/FAN/REC controls).
         Se oculta hasta que haya datos OBD o de luces: sin dato, no se muestra. -->
    <LinearLayout
        android:id="@+id/healthRow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_insight_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_badge">

            <ImageView
                android:id="@+id/cockpitHealthIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="Salud del vehículo"
                android:src="@drawable/ic_shield_check"
                android:tint="@color/green" />
        </FrameLayout>

        <TextView
            android:id="@+id/cockpitHealth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:maxLines="2"
            android:text="Salud: esperando datos OBD…"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/headlightState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="Luces —"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
