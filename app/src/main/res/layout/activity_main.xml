<?xml version="1.0" encoding="utf-8"?>
<!--
    IbizaDash continuous canvas.
    One Activity, one persistent MapView, one Dock. Focus only animates the split
    fraction (55/45 cockpit, 80/20 navigation, 25/75 module) and toggles layers.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_900">

    <LinearLayout
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- LEFT: map never leaves the tree -->
        <FrameLayout
            android:id="@+id/leftPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_map_vignette"
                android:clickable="false"
                android:focusable="false" />

            <ImageView
                android:id="@+id/remoteMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/obsidian_900"
                android:contentDescription="Mapa renderizado por el teléfono"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Flecha de posición local sobre el frame remoto (Fase 2):
                 el teléfono centra la ventana en el coche, así que la flecha
                 va fija en el centro y enmascara el salto entre frames. -->
            <FrameLayout
                android:id="@+id/remoteArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_play_button"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Tu posición"
                    android:src="@drawable/ic_nav"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Origen del mapa: TELÉFONO (frame remoto) o LOCAL (osmdroid).
                 Sin esto el cambio de fuente a los 5 s es invisible. -->
            <TextView
                android:id="@+id/mapSourceChip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_chip_glass"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="MAPA LOCAL"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/gpsStateChip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="52dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_chip_glass"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="GPS en vivo"
                android:textColor="@color/accent_sky"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_scrim_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_scrim_bottom" />

            <LinearLayout
                android:id="@+id/clockBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="20dp"
                android:paddingEnd="28dp">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.01"
                    android:text="--:--"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Clima"
                        android:src="@drawable/ic_weather_sun"
                        android:tint="@color/accent_sky" />

                    <TextView
                        android:id="@+id/weatherTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:text="--°"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Turn-by-turn pill: visible whenever the cockpit loses focus -->
            <LinearLayout
                android:id="@+id/navPill"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="28dp"
                android:layout_marginTop="124dp"
                android:background="@drawable/bg_nav_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_play_button">

                    <ImageView
                        android:id="@+id/navPillIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Maniobra"
                        android:src="@drawable/ic_nav"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navPillDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:id="@+id/navPillTitle"
                    android:text="Sin destino activo"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/navPillSub"
                    android:text="Toca para ver el mapa"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Persistent speed capsule for module focus -->
            <LinearLayout
                android:id="@+id/hudPill"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="104dp"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hudPillSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="KM/H" />

                <TextView
                    android:id="@+id/hudPillGear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_gear_active"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="28dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="P"
                    android:textColor="#06121F"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/hudPillFuel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="F --"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Vista de navegación a pantalla completa (foco NAV) -->
            <include layout="@layout/view_nav_overlay" />
        </FrameLayout>

        <!-- RIGHT: cockpit, mini HUD or focused module -->
        <FrameLayout
            android:id="@+id/rightPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45">

            <include layout="@layout/view_cockpit" />

            <include layout="@layout/view_mini_hud" />

            <include layout="@layout/view_media_module" />

            <include layout="@layout/view_vehicle_module" />

            <include layout="@layout/view_radio_module" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/nightDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alertCapsule"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_alert_capsule"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Alerta"
            android:src="@drawable/ic_alert"
            android:tint="@color/amber" />

        <TextView
            android:id="@+id/alertText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nowPlayingToast"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_now_playing_toast"
        android:elevation="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_media_stage"
            android:padding="3dp">

            <ImageView
                android:id="@+id/npToastArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_album"
                android:clipToOutline="true"
                android:contentDescription="Portada"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_media"
                android:tint="@color/text_muted" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/npToastTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Sin reproducción"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/npToastSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bluetooth · Radio FM"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/npToastEq"
            android:layout_width="30dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/bg_media_eq"
            android:indeterminateDuration="900" />

        <ImageView
            android:id="@+id/npToastStateIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Estado de reproducción"
            android:src="@drawable/ic_pause"
            android:tint="@color/accent_sky" />

        <TextView
            android:id="@+id/npToastTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="0:00"
            android:textColor="@color/text_faint"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/callBanner"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_alert_capsule"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/callText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnAnswer"
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="CONTESTAR"
            android:textColor="@color/green"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnHangup"
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="COLGAR"
            android:textColor="@color/danger"
            android:textSize="12sp" />
    </LinearLayout>

    <include layout="@layout/sheet_quick_settings" />

    <!-- Floating dock island -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dock_island"
        android:elevation="@dimen/elev_dock"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />
</FrameLayout>
