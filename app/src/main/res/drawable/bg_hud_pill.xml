<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#E60A1018"
                android:startColor="#E6141C29" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#5538BDF8"
                android:endColor="#0038BDF8"
                android:startColor="#0038BDF8" />
        </shape>
    </item>
</layer-list>
