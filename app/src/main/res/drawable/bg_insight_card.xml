<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de datos: superficie 1 + borde de luz superior -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#24FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#151A23"
                android:startColor="#1A2130" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
