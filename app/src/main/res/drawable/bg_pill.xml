<?xml version="1.0" encoding="utf-8"?>
<!-- Pill / tag: superficie 2, borde superior iluminado -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#22FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <solid android:color="#1F2735" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
