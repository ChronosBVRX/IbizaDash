<?xml version="1.0" encoding="utf-8"?>
<!-- Badge de icono: cuadrado redondeado, superficie 2 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#22FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#1A2230"
                android:startColor="#232E40" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
