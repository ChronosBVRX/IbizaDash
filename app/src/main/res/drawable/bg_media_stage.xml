<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#26FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="315"
                android:endColor="#1A2130"
                android:startColor="#26303F" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
