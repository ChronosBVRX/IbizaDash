<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja lateral: vidrio semántico (día/noche) + filo coral -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/sheet_bg" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/stroke_card" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:gravity="start">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00E87A5D"
                android:startColor="#99E87A5D" />
        </shape>
    </item>
</layer-list>
