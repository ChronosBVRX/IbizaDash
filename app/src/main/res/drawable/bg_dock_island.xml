<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:endColor="#F20A0F17"
                android:startColor="#F20F1622" />
            <corners android:radius="@dimen/radius_dock" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#6638BDF8"
                android:endColor="#0038BDF8"
                android:startColor="#0038BDF8" />
        </shape>
    </item>
</layer-list>
