<?xml version="1.0" encoding="utf-8"?>
<!-- Acción primaria: cobre Cupra con luz superior -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:angle="270"
                        android:endColor="#66FFFFFF"
                        android:startColor="#FFFFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape>
                    <gradient
                        android:angle="0"
                        android:endColor="#E07A5F"
                        android:startColor="#F4A261" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
