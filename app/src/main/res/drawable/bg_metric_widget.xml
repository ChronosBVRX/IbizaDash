<?xml version="1.0" encoding="utf-8"?>
<!-- Widget compacto de métrica -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#22FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#121822"
                android:startColor="#1C2433" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
